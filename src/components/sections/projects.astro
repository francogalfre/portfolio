---
import { HoverLinkPreview } from "@/components/ui/widgets/hover-link-preview";
import { projects } from "@/data/projects-content";

import { ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import ContributionGraphWidget from "@/components/ui/contribution-graph-widget";
import type { Activity } from "@/components/ui/contribution-graph";

let contributions: Activity[] = [];

try {
  const res = await fetch(
    "https://github-contributions-api.jogruber.de/v4/francogalfre",
  );

  const json = await res.json();
  const all: Activity[] = json.contributions ?? [];
  const cutoff = new Date();

  cutoff.setDate(cutoff.getDate() - 364);
  contributions = all.filter((c) => new Date(c.date) >= cutoff);
} catch {
  // fail silently
}
---

<section class="space-y-6">
  <div class="space-y-6" >
    <div class="space-y-2">
      <h2 class="text-md sm:text-lg font-[450] text-black leading-[90%] tracking-tighter animate-rise" style="--i: 1">my projects</h2>
      <p class="text-sm sm:text-[15px] font-normal text-gray-900 leading-[160%] animate-rise" style="--i: 2">
        A collection of projects I've built — from CLI tools to full-stack web applications. Each one is a chance to learn and build something useful.
      </p>
    </div>

    <hr class=" text-gray-200 animate-rise" style="--i: 3" />

    <ul class="projects-list flex flex-col gap-1.5">
      {projects.map((proj, index) => (
        <li class="project-item space-y-2 hover:bg-gray-100/70 transition-colors duration-500 rounded-lg py-2 px-3 -mx-3">
          <HoverLinkPreview
            client:visible
            href={`/projects/${proj.detailsUrl}`}
            external={false}
            previewImage={proj.image}
            imageAlt={`${proj.title} preview`}
            previewWidth={288}
            previewHeight={180}
            className="flex items-center w-full justify-between gap-4 animate-rise"
            style={{ "--i": 4 + index } as React.CSSProperties}
          >
            <div class="flex flex-col gap-1.5 py-2">
              <h4 class="text-md sm:text-lg font-[450] text-black leading-[90%] tracking-tighter">{proj.title}</h4>
              <p class="text-sm sm:text-[15px] text-secondary mt-0.5 leading-[120%]">{proj.description}</p>
            </div>
            <span class="text-secondary hidden sm:flex"><HugeiconsIcon icon={ArrowRight01Icon} size={16} /></span>
          </HoverLinkPreview>
        </li>
      ))}
    </ul>

    <div class="space-y-6 animate-rise" style={`--i: ${4 + projects.length}`}>
      <hr class="text-gray-200" />

      <ContributionGraphWidget data={contributions} client:load />
    </div>

<style>
  .project-item {
    transition: opacity 0.4s ease, filter 0.4s ease;
  }
  .projects-list:hover .project-item {
    opacity: 0.5;
    filter: blur(0.4px);
  }
  .projects-list:hover .project-item:hover {
    opacity: 1;
    filter: none;
  }
</style>
  </div>
</section>
