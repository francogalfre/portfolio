---
import { getCollection } from "astro:content";
import { format } from "date-fns";

import { ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import { estimateReadingTime } from "@/utils/reading-time";
import { toCalendarDate } from "@/utils/date";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<section class="space-y-6 animate-fade-in">
  <div class="space-y-6">
    <div class="space-y-2">
      <h2 class="text-[15px] sm:text-[16px] font-[450] text-black leading-[90%]">blog</h2>
      <p class="text-sm sm:text-[15px] font-normal text-gray-900 leading-[160%]">
        Notes about software engineering, AI agents and the things I learn while building. Written when I have something worth sharing.
      </p>
    </div>

    <hr class="text-gray-200" />

    {posts.length === 0 ? (
      <p class="text-sm sm:text-[15px] text-secondary leading-[160%]">
        No posts yet. The first one is on its way.
      </p>
    ) : (
      <ul class="posts-list flex flex-col gap-1.5">
        {posts.map((post) => (
          <li class="post-item space-y-2 hover:bg-gray-100/70 rounded-lg py-2 px-3 -mx-3">
            <a href={`/blog/${post.id}`} class="flex items-center w-full justify-between gap-4">
              <div class="flex flex-col gap-1.5 py-2">
                <h4 class="text-[14px] sm:text-[15px] font-[450] text-black leading-[90%]">{post.data.title}</h4>
                <p class="text-sm sm:text-[15px] text-secondary mt-0.5 leading-[120%]">{post.data.description}</p>
              </div>

              <div class="flex items-center gap-3 shrink-0">
                <div class="hidden sm:flex items-center gap-2 text-[13px] text-secondary tabular-nums">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {format(toCalendarDate(post.data.pubDate), "MMM yyyy").toLowerCase()}
                  </time>
                  <span class="text-gray-300">/</span>
                  <span>{estimateReadingTime(post.body ?? "")} min read</span>
                </div>
                <span class="text-secondary hidden sm:flex"><HugeiconsIcon icon={ArrowRight01Icon} size={16} /></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .post-item {
    transition: background-color 0.5s ease, opacity 0.4s ease, filter 0.4s ease;
  }
  .posts-list:hover .post-item {
    opacity: 0.5;
    filter: blur(0.4px);
  }
  .posts-list:hover .post-item:hover {
    opacity: 1;
    filter: blur(0);
  }
</style>
