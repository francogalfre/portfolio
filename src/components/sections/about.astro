---
import { Image } from "astro:assets";
import Gif from "@/assets/gifs/gif-2.gif";

import CompanyBadge from "@/components/ui/widgets/company-badge.astro";
import Signature from "@/components/ui/widgets/signature.astro";
import Spotify from "@/components/ui/spotify/spotify-player.astro";
import Sparkles from "@/components/sections/sparkles.astro";
import { HoverLinkPreview } from "@/components/ui/widgets/hover-link-preview";

import Me from "@/assets/images/me.webp";
import CrombieLogo from "@/assets/logos/crombie.webp";
import ShipperslabLogo from "@/assets/logos/shipperslab.svg";

import { getAgeData } from "@/utils/age-calculation";

const { years } = getAgeData();

// Seconds the signature takes to write. Everything else waits for it.
const SIG = 2.7;
// The hamster comes in first, then the signature is written, then everything else
const HAM = 0.7;
const END = HAM + SIG;
const at = (extra: number) => `--t: ${(END + extra).toFixed(2)}s`;
---

<!-- Intro (first landing only): flag the page before first paint -->
<script is:inline>
  (function () {
    if (window.__introChecked) return;
    window.__introChecked = true;
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("intro");
  })();
</script>

<Sparkles start={END + 0.15} />

<!-- Blur veil: above all content, below the signature; eases out when it is written -->
<div class="intro-veil" style={`--sig:${END}`} aria-hidden="true"></div>

<section class="flex flex-col gap-4">
  <div>
    <Image src={Gif} width={132} height={132} quality={60} priority alt="Animated hamster with orange fur working on a laptop" class="sig-lift relative rv-ham animate-rise w-18 sm:w-22 -ml-[6.5px] sm:-ml-[8px] hover:scale-105 hover:rotate-3 transition-transform duration-500" style={`--sig:${END}`} />

    <h1 class="sr-only">Franco Galfré</h1>
    <div class="sig-lift relative text-gray-900 mt-1" style={`--sig:${END}`}>
      <Signature width={230} total={SIG} start={HAM} class="max-sm:w-[185px]!" />
    </div>
  </div>

  <div class="flex flex-col gap-6 mb-8">
    <p class="rv rv-text animate-rise text-sm sm:text-[15px] font-normal sm:leading-[160%] text-gray-600" style={`--i: 1; ${at(0)}`} data-reveal>
      <span class="inline-block"><HoverLinkPreview href="https://www.linkedin.com/in/francogalfre/" previewImage={Me.src} imageAlt="Francogalfre avatar" previewWidth={160} previewHeight={128} className="relative inline-block text-gray-900" client:visible>I'm Franco!</HoverLinkPreview></span> I'm <span id="age-counter" class="text-primary" style="font-variant-numeric: tabular-nums;">{years}</span> years old and a passionate Software Engineer & AI Engineer who loves computing, coding, and coffee. I approach every challenge by constantly learning new <a href="/stack" class="accent-link text-primary">technologies</a>.

      <br /><br />

      Currently building amazing things at <CompanyBadge name="Crombie" logo={CrombieLogo} /> , and running <CompanyBadge name="Shipperslab" logo={ShipperslabLogo} /> while crafting personal <a href="/projects" class="accent-link text-primary">projects</a>.
    </p>
  </div>

  <div class="rv animate-rise" style={`--i: 2; ${at(0.75)}`}>
    <Spotify />
  </div>
</section>

<style is:global define:vars={{ chromeT: `${(END + 0.4).toFixed(2)}s` }}>
  /* Page chrome (theme toggle, blog link) fades in once the intro is done */
  html.intro #theme-toggle,
  html.intro .blog-link { animation-delay: var(--chromeT); }
</style>

<style is:global>
  /* ── Veil ── */
  .intro-veil { display: none; }

  html.intro .intro-veil {
    --veil-tint: rgb(255 255 255 / 0.55);
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    /* Blocks hover/clicks on everything below until it has fully faded (then visibility:hidden) */
    pointer-events: auto;
    background-color: var(--veil-tint);
    will-change: opacity;
    animation: veil-out 1300ms cubic-bezier(0.33, 1, 0.68, 1) calc(var(--sig) * 1s - 0.15s) forwards;
  }

  html[data-theme="dark"].intro .intro-veil { --veil-tint: rgb(15 15 15 / 0.55); }

  @keyframes veil-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Signature sits above the veil (z-110) only while the intro runs; afterwards it drops back
     so overlays like the hover preview can cover it */
  html.intro .sig-lift {
    z-index: 110;
    will-change: transform;
    animation: sig-drop 1ms calc(var(--sig) * 1s + 1.3s) forwards;
  }

  @keyframes sig-drop { to { z-index: auto; } }

  /* ── Intro reveal (after the signature): blocks rise, characters sharpen one by one ── */
  html.intro [data-reveal]:not([data-split]) { visibility: hidden; }

  html.intro .rv { animation: rv-in 900ms cubic-bezier(0.22, 1, 0.36, 1) var(--t, 0s) both; }
  html.intro .rv-text { animation: none; }

  /* Hamster: first thing on screen; `backwards` so hover transforms still work afterwards */
  html.intro .rv-ham {
    animation:
      ham-in 800ms cubic-bezier(0.22, 1.2, 0.36, 1) 0.1s backwards,
      sig-drop 1ms calc(var(--sig) * 1s + 1.3s) forwards;
  }

  @keyframes ham-in {
    from { opacity: 0; transform: translateY(10px) scale(0.8) rotate(-6deg); }
    to { opacity: 1; transform: none; }
  }

  html.intro .rv-c {
    display: inline-block;
    opacity: 0;
    will-change: opacity, transform;
    animation: rv-char 560ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--t, 0s) + var(--d, 0ms)) both;
  }

  html.intro [data-pop] {
    animation: rv-pop 650ms cubic-bezier(0.22, 1.2, 0.36, 1) calc(var(--t, 0s) + var(--d, 0ms)) both;
  }

  .rv-w { white-space: nowrap; }
  #age-counter { display: inline-block; }

  @keyframes rv-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes rv-char {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes rv-pop {
    from { opacity: 0; transform: translateY(6px) scale(0.94); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    html.intro .intro-veil { display: none; }
    html.intro .rv-ham,
    html.intro .rv,
    html.intro .rv-c,
    html.intro [data-pop] { animation: none; opacity: 1; filter: none; }
  }
</style>

<script>
  import { getAgeData } from "../../utils/age-calculation";

  const SIG_MS = 2700;
  const MAX_STAGGER = 22; // ms per character (words wait for their first character)
  const BUDGET = 900; // max ms to reveal a whole block, so long text doesn't drag

  // Split text nodes into per-character spans. Links with text only are walked; any other
  // inline element (badges, the age number, the hover-preview wrapper) pops in as a unit.
  function split(block: HTMLElement) {
    const total = (block.textContent ?? "").replace(/\s+/g, "").length || 1;
    const stagger = Math.min(MAX_STAGGER, BUDGET / total);
    let n = 0;
    const delay = () => `${Math.round(n * stagger)}ms`;

    const walk = (node: Node) => {
      for (const child of Array.from(node.childNodes)) {
        if (child instanceof HTMLElement) {
          if (child.tagName === "BR") continue;
          if (child.tagName === "A" && !child.querySelector("img, svg")) {
            walk(child);
            continue;
          }
          child.setAttribute("data-pop", "");
          child.style.setProperty("--d", delay());
          n += child.textContent?.trim().length ?? 0;
          continue;
        }
        if (child.nodeType !== Node.TEXT_NODE || !child.textContent?.trim()) continue;

        const text = child.textContent;
        const frag = document.createDocumentFragment();

        const sr = document.createElement("span");
        sr.className = "sr-only";
        sr.textContent = text;

        const visual = document.createElement("span");
        visual.setAttribute("aria-hidden", "true");

        for (const part of text.split(/(\s+)/)) {
          if (!part) continue;
          if (/^\s+$/.test(part)) {
            visual.append(" ");
            continue;
          }
          const word = document.createElement("span");
          word.className = "rv-w rv-c";
          word.textContent = part;
          word.style.setProperty("--d", delay());
          n += part.length;
          visual.append(word);
        }

        frag.append(sr, visual);
        child.replaceWith(frag);
      }
    };

    walk(block);
  }

  let timer: number | undefined;

  document.addEventListener("astro:page-load", () => {
    clearInterval(timer);
    clearTimeout(timer);

    if (document.documentElement.classList.contains("intro")) {
      for (const block of document.querySelectorAll<HTMLElement>("[data-reveal]:not([data-split])")) {
        block.setAttribute("data-split", "");
        split(block);
      }
    }

    const el = document.getElementById("age-counter");
    if (!el) return;

    const render = () => {
      const { years, days, hours, minutes, seconds } = getAgeData();
      const totalSeconds = days * 86400 + hours * 3600 + minutes * 60 + seconds;
      const decimal = totalSeconds / (365.25 * 86400);
      const text = (years + decimal).toFixed(7);
      const node = el.firstChild;
      if (node && node.nodeType === Node.TEXT_NODE) node.data = text;
      else el.textContent = text;
    };

    render();
    const start = document.documentElement.classList.contains("intro") ? (SIG_MS + 1500) : 0;
    timer = window.setTimeout(() => {
      timer = window.setInterval(render, 50);
    }, start);
  });

  document.addEventListener("astro:before-swap", () => {
    clearInterval(timer);
    clearTimeout(timer);
  });
</script>
