---
import { HugeiconsIcon } from "@hugeicons/react"
import { GameIcon } from "@hugeicons/core-free-icons"
---

<a
  href="/games"
  class="flex items-center justify-center bg-white ring-1 ring-black/[0.16] p-3 sm:p-4 rounded-full text-gray-600 transition-all duration-300 hover:scale-105 hover:text-primary active:scale-95"
  aria-label="Play games"
  title="Play games"
>
  <HugeiconsIcon icon={GameIcon} size={18} className="sm:size-[22px]" />
</a>
