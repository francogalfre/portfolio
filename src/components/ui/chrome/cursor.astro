<div id="cursor" transition:name="cursor" transition:persist></div>

<script>
  const cursor = document.getElementById("cursor");
  const interactive = "a, button, [role='button'], input, textarea, select, label";

  let raf = 0;
  let mx = 0;
  let my = 0;
  document.addEventListener("mousemove", (e) => {
    mx = e.clientX;
    my = e.clientY;
    if (raf || !cursor) return;
    raf = requestAnimationFrame(() => {
      raf = 0;
      cursor.style.setProperty("--x", mx + "px");
      cursor.style.setProperty("--y", my + "px");
    });
  }, { passive: true });

  document.addEventListener("mouseover", (e) => {
    if (!cursor) return;
    if (e.target.closest(interactive)) cursor.classList.add("expanded");
  });

  document.addEventListener("mouseout", (e) => {
    if (!cursor) return;
    if (e.target.closest(interactive)) cursor.classList.remove("expanded");
  });
</script>
