---
// Site-wide ambient background: two very soft warm lights + fine grain.
// Fixed, behind everything, never interactive.
---

<div class="backdrop" transition:name="backdrop" transition:persist aria-hidden="true">
  <div class="backdrop-light" style="top:-12%;left:-12%;background:#F6B23B"></div>
  <div class="backdrop-light" style="bottom:-18%;right:-12%;background:#F2895B"></div>
  <svg class="backdrop-grain" width="100%" height="100%">
    <filter id="backdrop-noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"></feTurbulence>
      <feColorMatrix type="saturate" values="0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter="url(#backdrop-noise)"></rect>
  </svg>
</div>

<style is:global>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .backdrop-light {
    position: absolute;
    width: 45vmax;
    height: 45vmax;
    border-radius: 9999px;
    filter: blur(110px);
    opacity: 0.03;
  }

  .backdrop-grain {
    position: absolute;
    inset: 0;
    opacity: 0.032;
    mix-blend-mode: multiply;
  }

  html[data-theme="dark"] .backdrop-light { opacity: 0.042; }
  html[data-theme="dark"] .backdrop-grain { mix-blend-mode: screen; opacity: 0.022; }
</style>
