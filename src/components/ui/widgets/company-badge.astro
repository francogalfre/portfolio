---
import type { ImageMetadata } from "astro";

interface Props {
	name: string;
	logo: ImageMetadata;
	href?: string;
}

const { name, logo, href = "/experience" } = Astro.props;
---

<a href={href} class="inline-flex items-center text-gray-900 gap-1 bg-gray-200/60 my-0.5 sm:my-0 px-2 py-0.5 border border-transparent rounded-full select-none align-middle ml-0.5 hover:border hover:border-gray-300 transition-all duration-300" >
    <img src={logo.src} alt={`${name} Logo`} class="w-4">
    {name}
</a>
