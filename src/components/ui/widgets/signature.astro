const approxLen = (d: string) => {
	const n = (d.match(/-?\d+(\.\d+)?/g) ?? []).map(Number);
	let len = 0;
	for (let i = 2; i + 1 < n.length; i += 2)
		len += Math.hypot(n[i] - n[i - 2], n[i + 1] - n[i - 1]);
	return len;
};

const lens = strokes0.map(([, d]) => approxLen(d));
const sum = lens.reduce((a, b) => a + b, 0);
const gap = 0.03; // pen-lift pause between strokes
const speed = (total - gap * strokes0.length) / sum;

let t = start;
const strokes = strokes0.map(([tr, d], i) => {
	const dur = lens[i] * speed;
	const s = { d, tr, delay: t, dur };
	t += dur + gap;
	return s;
});
---

<svg viewBox="47.2 8 516.3 114" fill="none" aria-hidden="true" style={`width:${width}px`} class:list={["sig", className]}>
	{
		strokes.map((s) => (
			<path
				transform={s.tr || undefined}
				d={s.d}
				pathLength="1"
				style={`--delay:${s.delay.toFixed(2)}s;--dur:${s.dur.toFixed(2)}s`}
			/>
		))
	}
</svg>

<style is:global>
	.sig {
		display: block;
		height: auto;
		overflow: visible;
	}

	.sig path {
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Intro: pen draws each stroke in turn. Otherwise the signature is simply there. */
	html.intro .sig path {
		stroke-dasharray: 1;
		stroke-dashoffset: 1;
		animation: sig-draw var(--dur) cubic-bezier(0.4, 0, 0.6, 1) var(--delay) both;
	}

	@keyframes sig-draw {
		from { stroke-dashoffset: 1; }
		to { stroke-dashoffset: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		html.intro .sig path { stroke-dasharray: none; stroke-dashoffset: 0; animation: none; }
	}
</style>
