---
import "./figure.css";
import { tones } from "./tones";

// Layout of the LangGraph graph, drawn top to bottom.
// Nodes on the "answer" path end in the chat; "agents" nodes end in Jira.
const W = 112;
const H = 28;

type Path = "both" | "answer" | "agents";

const nodes: { id: string; label: string; x: number; y: number; tone: string; path: Path; info: string }[] = [
  { id: "user", label: "User question", x: 200, y: 24, tone: tones.gray, path: "both", info: "Someone opens the chat and describes a problem" },
  { id: "rag", label: "RAG agent", x: 200, y: 92, tone: tones.teal, path: "both", info: "Searches the knowledge base, again if the first try isn't enough" },
  { id: "reply", label: "Answer in chat", x: 70, y: 164, tone: tones.teal, path: "answer", info: "Most conversations end here, with no ticket at all" },
  { id: "ticket", label: "Ticket agent", x: 290, y: 164, tone: tones.blue, path: "agents", info: "Interviews the user, one missing field at a time" },
  { id: "draft", label: "Drafter", x: 222, y: 252, tone: tones.blue, path: "agents", info: "Writes the title and description from the conversation" },
  { id: "classify", label: "Classifier", x: 340, y: 252, tone: tones.violet, path: "agents", info: "Sets category and priority by rule, at the same time" },
  { id: "state", label: "Shared state", x: 62, y: 252, tone: tones.amber, path: "agents", info: "One object every agent reads and writes: messages, context, draft" },
  { id: "review", label: "Human review", x: 281, y: 340, tone: tones.amber, path: "agents", info: "Waits for both branches, then pauses until the user approves" },
  { id: "jira", label: "Jira ticket", x: 281, y: 408, tone: tones.blue, path: "agents", info: "Created by a tool call, with the link sent back to the chat" },
];

const edges: [string, string, Path][] = [
  ["user", "rag", "both"],
  ["rag", "reply", "answer"],
  ["rag", "ticket", "agents"],
  ["ticket", "draft", "agents"],
  ["ticket", "classify", "agents"],
  ["draft", "review", "agents"],
  ["classify", "review", "agents"],
  ["review", "jira", "agents"],
];

const byId = Object.fromEntries(nodes.map((node) => [node.id, node]));

const curve = (from: string, to: string) => {
  const a = byId[from];
  const b = byId[to];
  const y1 = a.y + H / 2;
  const y2 = b.y - H / 2;
  const mid = (y1 + y2) / 2;
  return `M ${a.x} ${y1} C ${a.x} ${mid}, ${b.x} ${mid}, ${b.x} ${y2}`;
};

// Self-loop on the right side of the RAG agent: it can search more than once
const rag = byId.rag;
const loopX = rag.x + W / 2;
const loop = `M ${loopX} ${rag.y - 6} C ${loopX + 30} ${rag.y - 26}, ${loopX + 30} ${rag.y + 26}, ${loopX + 2} ${rag.y + 7}`;

// Box around the two agents that run in parallel
const draft = byId.draft;
const classify = byId.classify;
const lane = {
  x: draft.x - W / 2 - 8,
  y: draft.y - H / 2 - 10,
  width: classify.x - draft.x + W + 16,
  height: H + 20,
};

// Two-way link between the shared state and the parallel lane
const state = byId.state;
const stateLink = `M ${state.x + W / 2 + 4} ${state.y} L ${lane.x - 4} ${state.y}`;

const hint = "Hover a step to see what it does";
---

<figure class="fig graph" data-graph>
  <div class="fig-card">
    <div class="fig-bar">
      <span class="fig-title">One LangGraph graph</span>
      <span class="fig-status" data-status-text data-default={hint}>{hint}</span>
    </div>

    <svg viewBox="0 0 420 436" class="graph-svg" role="img" aria-label="The agent graph, from question to answer or Jira ticket">
      <defs>
        <marker id="graph-arrow" viewBox="0 0 6 6" refX="5" refY="3" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 6 3 L 0 6 z" fill="rgb(17 17 17 / 0.45)" />
        </marker>
      </defs>

      <g class="graph-lane" data-path="agents">
        <rect x={lane.x} y={lane.y} width={lane.width} height={lane.height} rx="12" />
        <text x={lane.x + 2} y={lane.y - 6}>in parallel</text>
      </g>

      {edges.map(([from, to, path]) => (
        <path d={curve(from, to)} class="graph-edge" data-path={path} />
      ))}

      <path d={loop} class="graph-loop" marker-end="url(#graph-arrow)" />
      <text x={loopX + 32} y={rag.y + 4} class="graph-note">search again</text>

      <path
        d={stateLink}
        class="graph-state-link"
        data-path="agents"
        marker-start="url(#graph-arrow)"
        marker-end="url(#graph-arrow)"
      />

      {nodes.map((node) => (
        <g class="graph-node" data-path={node.path} data-info={node.info} tabindex="0">
          <rect x={node.x - W / 2} y={node.y - H / 2} width={W} height={H} rx="14" />
          <circle cx={node.x - W / 2 + 14} cy={node.y} r="3.5" fill={node.tone} />
          <text x={node.x - W / 2 + 25} y={node.y + 4}>{node.label}</text>
        </g>
      ))}
    </svg>
  </div>
</figure>

<style>
  .graph-svg {
    display: block;
    width: 100%;
    max-width: 430px;
    margin: 0.5rem auto 0;
    overflow: visible;
  }

  .graph-edge {
    fill: none;
    stroke-width: 1.25;
    transition:
      opacity 0.4s var(--ease),
      stroke 0.4s var(--ease);
  }

  /* The short path to an answer is solid; the agents' path is dashed */
  .graph-edge[data-path="both"],
  .graph-edge[data-path="answer"] {
    stroke: rgb(17 17 17 / 0.4);
  }

  .graph-edge[data-path="agents"] {
    stroke: rgb(17 17 17 / 0.2);
    stroke-dasharray: 4 4;
  }

  .graph-loop,
  .graph-state-link {
    fill: none;
    stroke: rgb(17 17 17 / 0.45);
    stroke-width: 1.25;
  }

  .graph-state-link {
    stroke-dasharray: 2 3;
    transition: opacity 0.4s var(--ease);
  }

  .graph-note,
  .graph-lane text {
    font-size: 10.5px;
    fill: var(--color-secondary);
  }

  .graph-lane rect {
    fill: rgb(17 17 17 / 0.02);
    stroke: rgb(17 17 17 / 0.14);
    stroke-dasharray: 3 3;
  }

  .graph-lane {
    transition: opacity 0.4s var(--ease);
  }

  .graph-node {
    cursor: default;
    outline: none;
    transition: opacity 0.4s var(--ease);
  }

  .graph-node rect {
    fill: white;
    stroke: rgb(17 17 17 / 0.12);
    transition: stroke 0.25s var(--ease);
  }

  .graph-node text {
    font-size: 11.5px;
    fill: var(--ink);
  }

  /* Agents stay muted until their path is hovered */
  .graph-node[data-path="agents"],
  .graph-lane,
  .graph-state-link {
    opacity: 0.5;
  }

  .graph-node:hover rect,
  .graph-node:focus-visible rect {
    stroke: rgb(17 17 17 / 0.5);
  }

  .graph[data-hover="agents"] :is(.graph-node, .graph-lane, .graph-state-link)[data-path="agents"] {
    opacity: 1;
  }

  .graph[data-hover="agents"] .graph-edge[data-path="agents"] {
    stroke: rgb(17 17 17 / 0.55);
    animation: graph-flow 0.8s linear infinite;
  }

  .graph[data-hover="agents"] [data-path="answer"],
  .graph[data-hover="answer"] [data-path="agents"] {
    opacity: 0.2;
  }

  .graph[data-hover="answer"] .graph-edge[data-path="answer"] {
    stroke: rgb(17 17 17 / 0.7);
  }

  @keyframes graph-flow {
    to {
      stroke-dashoffset: -8;
    }
  }

  @media (max-width: 520px) {
    .graph .fig-status {
      width: 100%;
      margin: 0.25rem 0 0;
    }
  }
</style>

<script>
  import { swapText } from "./swap-text";

  document.querySelectorAll<HTMLElement>("[data-graph]").forEach((figure) => {
    const status = figure.querySelector<HTMLElement>("[data-status-text]");

    figure.querySelectorAll<SVGGElement>(".graph-node").forEach((node) => {
      const enter = () => {
        swapText(status, node.dataset.info ?? "");
        // Shared nodes (question, RAG) belong to both paths: highlight neither
        if (node.dataset.path !== "both") figure.dataset.hover = node.dataset.path;
      };

      const leave = () => {
        swapText(status, status?.dataset.default ?? "");
        delete figure.dataset.hover;
      };

      node.addEventListener("mouseenter", enter);
      node.addEventListener("focus", enter);
      node.addEventListener("mouseleave", leave);
      node.addEventListener("blur", leave);
    });
  });
</script>
