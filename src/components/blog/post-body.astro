---
---

<div class="post-body">
  <slot />
</div>

<style is:global>
  .post-body {
    font-size: 15px;
    line-height: 1.75;
    color: var(--color-gray-700);
  }

  .post-body > * + * {
    margin-top: 1.25rem;
  }

  .post-body h2,
  .post-body h3,
  .post-body h4 {
    color: #000;
    font-weight: 450;
    letter-spacing: -0.01em;
    scroll-margin-top: 6rem;
  }

  .post-body h2 {
    font-size: 17px;
    line-height: 1.4;
    margin-top: 2.75rem;
  }

  .post-body h3 {
    font-size: 15.5px;
    line-height: 1.4;
    margin-top: 2.25rem;
  }

  .post-body h4 {
    font-size: 15px;
    color: var(--color-gray-700);
    margin-top: 1.75rem;
  }

  .post-body strong {
    font-weight: 550;
    color: #000;
  }

  .post-body a {
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-gray-300);
    transition: color 0.4s ease, text-decoration-color 0.4s ease;
  }

  .post-body a:hover {
    color: var(--color-primary);
    text-decoration-color: var(--color-primary);
  }

  .post-body ul,
  .post-body ol {
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .post-body ul {
    list-style: disc;
  }

  .post-body ol {
    list-style: decimal;
  }

  .post-body li::marker {
    color: var(--color-gray-400);
  }

  .post-body blockquote {
    border-left: 2px solid var(--color-primary);
    padding-left: 1rem;
    color: var(--color-gray-600);
  }

  .post-body hr {
    border-color: var(--color-gray-200);
    margin-block: 2.5rem;
  }

  .post-body img {
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-gray-100);
  }

  .post-body figure figcaption {
    margin-top: 0.5rem;
    font-size: 12.5px;
    color: var(--color-secondary);
    text-align: center;
  }

  .post-body table {
    width: 100%;
    font-size: 14px;
    border-collapse: collapse;
  }

  .post-body th,
  .post-body td {
    border: 1px solid var(--color-gray-200);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .post-body th {
    background: var(--color-gray-50);
    font-weight: 500;
  }

  /* ── inline code ── */
  .post-body :not(pre) > code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.86em;
    background: var(--color-gray-100);
    border: 1px solid var(--color-gray-200);
    border-radius: 0.3rem;
    padding: 0.1rem 0.3rem;
  }

  /* ── code blocks ── */
  .post-body .code-block {
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    overflow: hidden;
    background: #fff;
  }

  .post-body .code-block-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    padding: 0 0.5rem 0 0.75rem;
    background: var(--color-muted);
    border-bottom: 1px solid var(--color-border);
  }

  .post-body .code-block-lang {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--color-muted-foreground);
  }

  .post-body .code-block-copy {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted-foreground);
    background: transparent;
    border: none;
    border-radius: 0.375rem;
    padding: 0.3rem;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .post-body .code-block-copy:hover {
    color: var(--color-foreground);
    background: var(--color-border);
  }

  .post-body .code-block-copy svg {
    width: 14px;
    height: 14px;
  }

  .post-body pre {
    margin: 0;
    padding: 0.875rem 1rem;
    overflow-x: auto;
    background: #fff !important;
  }

  .post-body pre code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    line-height: 1.65;
  }
</style>

<script>
  const COPY_ICON = `
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
      <path d="M9 15C9 12.1716 9 10.7574 9.87868 9.87868C10.7574 9 12.1716 9 15 9L16 9C18.8284 9 20.2426 9 21.1213 9.87868C22 10.7574 22 12.1716 22 15V16C22 18.8284 22 20.2426 21.1213 21.1213C20.2426 22 18.8284 22 16 22H15C12.1716 22 10.7574 22 9.87868 21.1213C9 20.2426 9 18.8284 9 16L9 15Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
      <path d="M16.9999 9C16.9975 6.04291 16.9528 4.51121 16.092 3.46243C15.9258 3.25989 15.7401 3.07418 15.5376 2.90796C14.4312 2 12.7875 2 9.5 2C6.21252 2 4.56878 2 3.46243 2.90796C3.25989 3.07417 3.07418 3.25989 2.90796 3.46243C2 4.56878 2 6.21252 2 9.5C2 12.7875 2 14.4312 2.90796 15.5376C3.07417 15.7401 3.25989 15.9258 3.46243 16.092C4.51121 16.9528 6.04291 16.9975 9 16.9999" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
    </svg>
  `;

  const CHECK_ICON = `
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
      <path d="M5 14L8.5 17.5L19 6.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"/>
    </svg>
  `;

  const blocks = document.querySelectorAll<HTMLPreElement>(".post-body pre");

  blocks.forEach((pre) => {
    if (pre.parentElement?.classList.contains("code-block")) return;

    const wrapper = document.createElement("div");
    wrapper.className = "code-block";

    const header = document.createElement("div");
    header.className = "code-block-header";

    const lang = document.createElement("span");
    lang.className = "code-block-lang";
    lang.textContent = pre.dataset.language ?? "code";

    const copy = document.createElement("button");
    copy.className = "code-block-copy";
    copy.type = "button";
    copy.setAttribute("aria-label", "Copy code");
    copy.innerHTML = COPY_ICON;

    copy.addEventListener("click", async () => {
      await navigator.clipboard.writeText(pre.innerText);
      copy.innerHTML = CHECK_ICON;
      copy.setAttribute("aria-label", "Copied");
      setTimeout(() => {
        copy.innerHTML = COPY_ICON;
        copy.setAttribute("aria-label", "Copy code");
      }, 1500);
    });

    header.append(lang, copy);

    pre.replaceWith(wrapper);
    wrapper.append(header, pre);
  });
</script>
