---
import { getTweet } from "react-tweet/api";
import { enrichTweet } from "react-tweet/utils";

interface Props {
  id: string;
}

const { id } = Astro.props;

const VERIFIED = `
  <svg viewBox="0 0 22 22" fill="currentColor" aria-label="Verified account" role="img">
    <path d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.687.878.633.132 1.29.084 1.897-.136.274.586.705 1.084 1.246 1.439.54.354 1.17.551 1.816.569.647-.016 1.276-.213 1.817-.567s.972-.854 1.245-1.44c.604.239 1.266.296 1.903.164.636-.132 1.22-.447 1.68-.907.46-.46.776-1.044.908-1.681s.075-1.299-.165-1.903c.586-.274 1.084-.705 1.439-1.246.354-.54.551-1.17.569-1.816zM9.662 14.85l-3.429-3.428 1.293-1.302 2.072 2.072 4.4-4.794 1.347 1.246z"/>
  </svg>
`;

const X_LOGO = `
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
  </svg>
`;

function formatNumber(num: number): string {
  if (num >= 1000000) return (num / 1000000).toFixed(1).replace(/\.0$/, "") + "M";
  if (num >= 1000) return (num / 1000).toFixed(1).replace(/\.0$/, "") + "k";
  return String(num);
}

function formatDate(dateString: string): string {
  const date = new Date(dateString);
  const hours = date.getHours();
  const minutes = date.getMinutes();
  const ampm = hours >= 12 ? "PM" : "AM";
  const hour12 = hours % 12 || 12;
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${hour12}:${String(minutes).padStart(2, "0")} ${ampm} · ${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
}

let tweet: any = null;
try {
  const data: any = await getTweet(id);
  if (data) {
    const entities = data.entities ?? {};
    tweet = enrichTweet({
      ...data,
      entities: {
        ...entities,
        hashtags: entities.hashtags ?? [],
        urls: entities.urls ?? [],
        user_mentions: entities.user_mentions ?? [],
        symbols: entities.symbols ?? [],
      },
    });
  }
} catch {
  tweet = null;
}
---

{tweet === null ? (
  <div class="tweet tweet-missing">Tweet not found</div>
) : (
  <div class="tweet">
    <div class="tweet-header">
      <img
        src={tweet.user.profile_image_url_https}
        alt={tweet.user.name}
        loading="lazy"
        width="38"
        height="38"
        class="tweet-avatar"
      />
      <div class="tweet-meta">
        <span class="tweet-name">
          {tweet.user.name}
          {(tweet.user.verified || tweet.user.is_blue_verified) && (
            <span class="tweet-verified" set:html={VERIFIED} />
          )}
        </span>
        <span class="tweet-handle">@{tweet.user.screen_name}</span>
      </div>
      <a href={tweet.url} target="_blank" rel="noopener noreferrer" class="tweet-x" aria-label="Open on X">
        <span set:html={X_LOGO} />
      </a>
    </div>

    <p class="tweet-body">
      {tweet.entities.map((entity: any) => {
        switch (entity.type) {
          case "url":
          case "symbol":
          case "hashtag":
          case "mention":
            return (
              <a href={entity.href} target="_blank" rel="noopener noreferrer" class="tweet-link">
                {entity.text}
              </a>
            );
          case "text":
            return <span set:html={entity.text} />;
          default:
            return null;
        }
      })}
    </p>

    <div class="tweet-footer">
      <time datetime={tweet.created_at}>{formatDate(tweet.created_at)}</time>
      <a href={tweet.like_url} target="_blank" rel="noopener noreferrer" class="tweet-like">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 18 18" class="tweet-like-heart">
          <path d="M12.164,2c-1.195,.015-2.324,.49-3.164,1.306-.84-.815-1.972-1.291-3.178-1.306-2.53,.015-4.582,2.084-4.572,4.609,0,5.253,5.306,8.429,6.932,9.278,.256,.133,.537,.2,.818,.2s.562-.067,.817-.2c1.626-.848,6.933-4.024,6.933-9.275,.009-2.528-2.042-4.597-4.586-4.612Z" fill="currentColor"/>
        </svg>
        {formatNumber(tweet.favorite_count)}
      </a>
    </div>
  </div>
)}

<style>
  .tweet {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-background);
    text-decoration: none;
  }

  .tweet-missing {
    color: var(--color-muted-foreground);
    font-size: 14px;
  }

  .tweet-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .tweet-avatar {
    width: 38px;
    height: 38px;
    border-radius: 9999px;
    flex-shrink: 0;
  }

  .tweet-meta {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    min-width: 0;
    flex: 1;
  }

  .tweet-name {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-foreground);
  }

  .tweet-verified {
    display: inline-flex;
    align-items: center;
    color: #1c9bf1;
  }

  .tweet-verified svg {
    width: 16px;
    height: 16px;
  }

  .tweet-handle {
    font-size: 13px;
    color: var(--color-muted-foreground);
  }

  .tweet-x {
    display: flex;
    align-items: center;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .tweet-x svg {
    width: 20px;
    height: 20px;
  }

  .tweet-body {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--color-foreground);
    white-space: pre-wrap;
  }

  .tweet-link {
    color: #1c9bf1;
    text-decoration: none;
  }

  .tweet-link:hover {
    text-decoration: underline;
  }

  .tweet-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-muted-foreground);
  }

  .tweet-like {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted-foreground);
    text-decoration: none;
  }

  .tweet-like-heart {
    color: #db2777;
  }
</style>
