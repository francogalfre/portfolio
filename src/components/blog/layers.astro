---
import "./figure.css";
import { tones, type Tone } from "./tones";

interface Item {
  name: string;
  logo?: string;
}

interface Layer {
  label: string;
  why: string;
  tone: Tone;
  items: Item[];
}

interface Props {
  title: string;
  status: string;
  layers: Layer[];
}

const { title, status, layers } = Astro.props;
---

<figure class="fig layers" data-layers>
  <div class="fig-card layers-boundary">
    <div class="fig-bar">
      <span class="fig-title">{title}</span>
      <span class="fig-status" data-status-text data-default={status}>{status}</span>
    </div>

    <div class="layers-rows">
      {layers.map((layer) => (
        <div class="layers-row" style={`--tone: ${tones[layer.tone]}`} data-why={layer.why} tabindex="0">
          <span class="layers-label">
            <span class="fig-dot" />
            {layer.label}
          </span>
          <div class="layers-items">
            {layer.items.map((item) => (
              <span class="layers-item">
                {item.logo && <img src={item.logo} alt="" class="layers-logo" />}
                {item.name}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</figure>

<style>
  .layers-boundary {
    border-style: dashed;
    border-color: rgb(17 17 17 / 0.16);
  }

  .layers-rows {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .layers-row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    background: white;
    outline: none;
    transition:
      opacity 0.35s var(--ease),
      border-color 0.35s var(--ease);
  }

  .layers-rows:has(.layers-row:is(:hover, :focus-visible)) .layers-row:not(:hover, :focus-visible) {
    opacity: 0.35;
  }

  .layers-row:hover,
  .layers-row:focus-visible {
    border-color: color-mix(in srgb, var(--tone) 55%, white);
  }

  .layers-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 13px;
    color: var(--color-secondary);
  }

  .layers-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .layers-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 9999px;
    font-size: 12.5px;
    color: var(--ink);
  }

  /* Undo the post body's image styles for these tiny logos */
  .layers-item .layers-logo {
    width: 13px !important;
    height: 13px !important;
    margin: 0 !important;
    border: 0 !important;
    border-radius: 0 !important;
    aspect-ratio: auto !important;
    background: none !important;
    animation: none !important;
    object-fit: contain;
  }

  @media (max-width: 520px) {
    .layers-row {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .layers .fig-status {
      width: 100%;
      margin: 0.25rem 0 0;
    }
  }
</style>

<script>
  import { swapText } from "./swap-text";

  document.querySelectorAll<HTMLElement>("[data-layers]").forEach((figure) => {
    const status = figure.querySelector<HTMLElement>("[data-status-text]");
    if (!status) return;

    figure.querySelectorAll<HTMLElement>(".layers-row").forEach((row) => {
      const show = () => swapText(status, row.dataset.why ?? "");
      const reset = () => swapText(status, status.dataset.default ?? "");
      row.addEventListener("mouseenter", show);
      row.addEventListener("focus", show);
      row.addEventListener("mouseleave", reset);
      row.addEventListener("blur", reset);
    });
  });
</script>
