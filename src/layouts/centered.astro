---
import "@/global.css";
import "lenis/dist/lenis.css";
import { ClientRouter } from "astro:transitions";

import Cursor from "@/components/ui/chrome/cursor.astro";
import BlogLink from "@/components/ui/chrome/blog-link.astro";
import SocialsDock from "@/components/ui/chrome/socials-dock.astro";
import FloatingButtons from "@/components/ui/chrome/floating-buttons.astro";
import SoundEffects from "@/components/ui/chrome/sound-effects.astro";

import SEO from "@/components/seo/seo.astro";

import type { PageSEO } from "@/data/seo-content";

interface Props {
	seo: PageSEO;
}

const { seo } = Astro.props;
---

<html lang="es">
  <head>
    <SEO page={seo} />
    <meta charset="UTF-8">
    <ClientRouter />
  </head>
  <body class="relative">
    <Cursor />
    <BlogLink />
    <FloatingButtons />
    <main class="w-full max-w-2xl px-5 sm:px-6 md:px-12 py-16 md:py-20 min-h-dvh flex flex-col mx-auto overflow-x-clip">
      <div class="my-auto w-full flex flex-col gap-6">
        <slot />
      </div>
    </main>

    <SocialsDock />
    <SoundEffects />

    <script>
      import { getLenis } from "@/utils/smooth-scroll";

      const lenis = getLenis();
      let dockVisible = false;

      const setDock = (show: boolean) => {
        const dock = document.getElementById("socials-dock");
        if (!dock || dockVisible === show) return;
        dockVisible = show;
        dock.style.opacity = show ? "1" : "0";
        dock.style.transform = show ? "translateY(0)" : "translateY(100%)";
      };

      window.addEventListener("wheel", (e) => {
        if (e.deltaY > 0) setDock(true);
        else if (e.deltaY < 0) setDock(false);
      });

      lenis.on("scroll", ({ scroll }: { scroll: number }) => {
        if (scroll > 5) setDock(true);
        else if (scroll === 0) setDock(false);
      });

      // New page = fresh (hidden) dock element
      document.addEventListener("astro:after-swap", () => {
        dockVisible = false;
      });
    </script>
  </body>
</html>
