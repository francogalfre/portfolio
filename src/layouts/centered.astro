---
import "@/global.css";
import "lenis/dist/lenis.css";

import Cursor from "@/components/ui/chrome/cursor.astro";
import BlogLink from "@/components/ui/chrome/blog-link.astro";
import SocialsDock from "@/components/ui/chrome/socials-dock.astro";
import FloatingButtons from "@/components/ui/chrome/floating-buttons.astro";
import SoundEffects from "@/components/ui/chrome/sound-effects.astro";

import SEO from "@/components/seo/seo.astro";

import type { PageSEO } from "@/data/seo-content";

interface Props {
	seo: PageSEO;
}

const { seo } = Astro.props;
---

<html lang="es">
  <head>
    <SEO page={seo} />
    <meta charset="UTF-8">
  </head>
  <body class="relative">
    <Cursor />
    <BlogLink />
    <FloatingButtons />
    <main class="w-full max-w-2xl px-5 sm:px-6 md:px-12 py-16 md:py-20 min-h-dvh flex flex-col mx-auto overflow-x-clip">
      <div class="my-auto w-full flex flex-col gap-6">
        <slot />
      </div>
    </main>

    <SocialsDock />
    <SoundEffects />

    <script>
      import Lenis from "lenis";

      const dock = document.getElementById("socials-dock");
      const lenis = new Lenis({ autoRaf: true });

      if (dock) {
        let dockVisible = false;

        function showDock() {
          if (!dockVisible) {
            dockVisible = true;
            dock.style.opacity = "1";
            dock.style.transform = "translateY(0)";
          }
        }

        function hideDock() {
          if (dockVisible) {
            dockVisible = false;
            dock.style.opacity = "0";
            dock.style.transform = "translateY(100%)";
          }
        }

        window.addEventListener("wheel", (e) => {
          if (e.deltaY > 0) {
            showDock();
          } else if (e.deltaY < 0) {
            hideDock();
          }
        });

        lenis.on("scroll", ({ scroll }) => {
          if (scroll > 5) {
            showDock();
          } else if (scroll === 0) {
            hideDock();
          }
        });
      }
    </script>
  </body>
</html>
