---
import "@/global.css";
import "lenis/dist/lenis.css";

import Cursor from "@/components/ui/chrome/cursor.astro";
import FloatingButtons from "@/components/ui/chrome/floating-buttons.astro";
import SoundEffects from "@/components/ui/chrome/sound-effects.astro";

import SEO from "@/components/seo/seo.astro";
import type { PageSEO } from "@/data/seo-content";

interface Props {
	seo: PageSEO;
}

const { seo } = Astro.props;
---

<html lang="es">
  <head>
    <SEO page={seo} />
    <meta charset="UTF-8">
  </head>
  <body>
    <Cursor />
    <FloatingButtons />
    <main class="w-full max-w-2xl px-5 sm:px-6 md:px-12 pt-20 md:pt-[16vh] pb-24 min-h-dvh flex flex-col gap-6 mx-auto overflow-x-clip">
      <slot />
    </main>

    <script>
      import Lenis from "lenis";
      new Lenis({ autoRaf: true });
    </script>
    <SoundEffects />
  </body>
</html>
