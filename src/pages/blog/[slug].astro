---
import { getCollection, render } from "astro:content";
import { format } from "date-fns";

import { ArrowLeft01Icon, ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";

import BaseLayout from "@/layouts/base.astro";
import Breadcrumb from "@/components/ui/widgets/breadcrumb.astro";
import PostBody from "@/components/blog/post-body.astro";

import { SITE_URL } from "@/data/seo-content";
import { estimateReadingTime } from "@/utils/reading-time";
import { renderInlineMarkdown } from "@/utils/inline-markdown";
import { toCalendarDate } from "@/utils/date";

export async function getStaticPaths() {
	const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
		(a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
	);

	return posts.map((post, index) => ({
		params: { slug: post.id },
		props: {
			post,
			prevPost: index > 0 ? posts[index - 1] : undefined,
			nextPost: index < posts.length - 1 ? posts[index + 1] : undefined,
		},
	}));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);

const {
	title,
	description,
	pubDate,
	tags,
	cover,
	coverAlt,
	coverCredit,
} = post.data;

const seo = {
	title: `${title} — Franco Galfré`,
	description,
	keywords: tags.join(", "),
	image: cover,
};

const readingTime = estimateReadingTime(post.body ?? "");
const postUrl = new URL(`/blog/${post.id}`, SITE_URL).toString();
const coverCreditHtml = renderInlineMarkdown(coverCredit);
const displayDate = toCalendarDate(pubDate);

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description,
	image: new URL(cover, SITE_URL).toString(),
	datePublished: pubDate.toISOString(),
	author: {
		"@type": "Person",
		name: "Franco Galfré",
	},
	mainEntityOfPage: postUrl,
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <Breadcrumb lastPage="blog" actualPage={title} />

  <article class="space-y-8 animate-fade-in">
    <figure class="space-y-2">
      <img
        src={cover}
        alt={coverAlt || title}
        class="w-full aspect-[16/9] rounded-lg border border-gray-100 object-cover"
      />

      <figcaption class="flex items-center justify-between gap-4 text-[12.5px] text-secondary">
        <span set:html={coverCreditHtml} />
      </figcaption>
    </figure>

    <header class="space-y-4">
        <div class="flex flex-col gap-2">
            <h1 class="text-[20px] sm:text-3xl font-medium text-black leading-[130%] tracking-tighter">
              {title}
            </h1>

            <p class="text-sm sm:text-md text-secondary leading-[160%]">
              {description}
            </p>
        </div>

      <div class="flex items-center gap-2 text-sm text-secondary">
        {tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {tags.map((tag) => (
                <span class="px-2 py-1 text-xs bg-gray-100 text-gray-700 rounded-full">
                  {tag}
                </span>
              ))}
            </div>
        )}

        <time datetime={pubDate.toISOString()} class="tabular-nums">
          {format(displayDate, "MMMM d, yyyy").toLowerCase()}
        </time>
        <span class="text-gray-300">/</span>
        <span>{readingTime} min read</span>
      </div>
    </header>

    <hr class="text-gray-200" />

    <PostBody>
      <Content />
    </PostBody>

    {(prevPost || nextPost) && (
      <>
        <hr class="text-gray-200" />
        <nav class="grid grid-cols-2 gap-3">
          <div>
            {prevPost && (
              <a
                href={`/blog/${prevPost.id}`}
                class="group flex flex-col gap-1.5 rounded-lg py-2 px-3 -mx-3 hover:bg-gray-100/70 transition-colors duration-500"
              >
                <span class="flex items-center gap-1 text-[12px] text-secondary group-hover:text-primary transition-colors duration-500">
                  <HugeiconsIcon icon={ArrowLeft01Icon} size={14} />
                  newer
                </span>
                <span class="text-[13px] sm:text-[14px] text-black leading-[120%] truncate">{prevPost.data.title}</span>
              </a>
            )}
          </div>
          <div>
            {nextPost && (
              <a
                href={`/blog/${nextPost.id}`}
                class="group flex flex-col items-end gap-1.5 rounded-lg py-2 px-3 -mx-3 text-right hover:bg-gray-100/70 transition-colors duration-500"
              >
                <span class="flex items-center gap-1 text-[12px] text-secondary group-hover:text-primary transition-colors duration-500">
                  older
                  <HugeiconsIcon icon={ArrowRight01Icon} size={14} />
                </span>
                <span class="text-[13px] sm:text-[14px] text-black leading-[120%] truncate">{nextPost.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      </>
    )}
  </article>
</BaseLayout>
